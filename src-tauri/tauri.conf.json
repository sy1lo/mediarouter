{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaRouter",
  "version": "0.3.0",
  "identifier": "com.medialib.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MediaRouter",
        "width": 1380,
        "height": 880,
        "minWidth": 1120,
        "minHeight": 700,
        "center": true,
        "maximized": true,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#0e0e13"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://thumb.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://thumb.localhost ws://localhost:1420 http://localhost:1420; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
